{
  "manifest_version": 3,
  "name": "Smart Message Reminder",
  "version": "1.0.0",
  "description": "Create private, local reminders from visible WhatsApp Web messages.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_title": "Smart Message Reminder",
    "default_popup": "index.html"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://smart-message-reminder-sanjaikumar.onrender.com/*"
    ]
  }
}
